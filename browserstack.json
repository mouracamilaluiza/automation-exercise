{
  "testObservability": false,
  "browsers": [
    { "browser": "chrome", "os": "Windows 11", "versions": ["latest"] },
    { "browser": "firefox", "os": "Windows 11", "versions": ["latest"] }
  ],
  "run_settings": {
    "cypress_version": "15.21.1",
    "cypress_config_file": "./cypress.config.js",
    "project_name": "automation-exercise-tcc",
    "build_name": "TCC - casos obrigatorios",
    "parallels": 1,
    "specs": ["cypress/e2e/*.cy.js"],
    "npm_dependencies": {
      "cypress": "15.21.1",
      "cypress-mochawesome-reporter": "5.0.0",
      "allure-cypress": "3.14.0",
      "cypress-on-fix": "1.1.0"
    },
    "exclude": [
      "node_modules",
      ".git",
      "allure-results",
      "allure-report",
      "cypress/reports",
      "cypress/videos",
      "cypress/screenshots",
      ".env*",
      "cypress.env.json",
      "browserstack.local.json"
    ]
  },
  "connection_settings": { "local": false }
}
