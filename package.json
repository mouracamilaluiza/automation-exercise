{
  "name": "automation-exercise-tcc",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E dos casos 1, 2, 3, 4, 5, 8, 9, 10, 15 e 16",
  "scripts": {
    "pretest": "npm run allure:clean",
    "pretest:chrome": "npm run allure:clean",
    "pretest:open": "npm run allure:clean",
    "test": "cypress run",
    "test:open": "cypress open",
    "test:chrome": "cypress run --browser chrome",
    "test:browserstack": "node scripts/run-browserstack.cjs",
    "allure:clean": "node scripts/clean-allure.cjs",
    "allure:generate": "node scripts/check-allure-results.cjs && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "allure-commandline": "2.46.1",
    "allure-cypress": "3.14.0",
    "browserstack-cypress-cli": "1.37.2",
    "cypress": "15.19.0",
    "cypress-mochawesome-reporter": "5.0.0",
    "cypress-on-fix": "1.1.0"
  }
}
